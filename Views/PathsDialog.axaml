<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveryGallery.Views.PathsDialog"
        Width="560" Height="360" WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconSettings}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" />

            <TextBlock x:Name="GamePathLabel" Grid.Row="1" FontSize="12" Margin="0,16,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBox x:Name="GamePathBox" Grid.Column="0" Classes="search" FontSize="13"
                         Margin="0,0,8,0" IsEnabled="False" TextChanged="PathBox_TextChanged" />
                <Button x:Name="GameBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                        Content="..." IsEnabled="False" Click="GameBrowseButton_Click" />
            </Grid>

            <TextBlock x:Name="SavePathLabel" Grid.Row="3" FontSize="12" Margin="0,16,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <TextBox x:Name="SavePathBox" Grid.Column="0" Classes="search" FontSize="13"
                         Margin="0,0,8,0" TextChanged="PathBox_TextChanged" />
                <Button x:Name="SaveBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                        Content="..." Click="SaveBrowseButton_Click" />
            </Grid>

            <TextBlock x:Name="HintText" Grid.Row="5" FontSize="11" Margin="0,10,0,0"
                       HorizontalAlignment="Stretch" MaxWidth="500"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Top" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CloseDialogButton" Classes="secondary" Width="100" Margin="0,0,10,0" Click="CloseButton_Click" />
                <Button x:Name="SaveButton" Classes="primary" Width="150" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
