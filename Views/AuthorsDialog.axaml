<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        x:Class="LiveryGallery.Views.AuthorsDialog"
        x:DataType="vm:AuthorsViewModel"
        Width="560" Height="640" WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <DataTemplate x:Key="AuthorCardRowTemplate" x:DataType="vm:AuthorCardRowViewModel">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,12">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Border IsVisible="{Binding IsAutoGenerated}" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Strings.AuthorCardAutoGeneratedBadge}" FontSize="10"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="{x:Static loc:Strings.ButtonEdit}" Classes="secondary" Padding="10,4"
                                    Command="{Binding $parent[Window].((vm:AuthorsViewModel)DataContext).EditCardCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="{x:Static loc:Strings.ButtonDelete}" Classes="danger" Padding="10,4"
                                    Command="{Binding $parent[Window].((vm:AuthorsViewModel)DataContext).DeleteCardCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock IsVisible="{Binding HasAliases}" Text="{Binding AliasesText}" FontSize="11"
                               Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                    <TextBlock IsVisible="{Binding HasDescription}" Text="{Binding Description}" FontSize="12.5"
                               Margin="0,8,0,0" TextWrapping="Wrap" />

                    <StackPanel IsVisible="{Binding HasAnyLink}" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button IsVisible="{Binding HasTwitter}" Classes="icon" Width="28" Height="28"
                                CornerRadius="14" Padding="0" ToolTip.Tip="{x:Static loc:Strings.AuthorCardTwitterLabel}"
                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding TwitterUrl}">
                            <Path Data="{StaticResource IconTwitter}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button IsVisible="{Binding HasYouTube}" Classes="icon" Width="28" Height="28"
                                CornerRadius="14" Padding="0" ToolTip.Tip="{x:Static loc:Strings.AuthorCardYouTubeLabel}"
                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding YouTubeUrl}">
                            <Path Data="{StaticResource IconYoutube}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource AccentBrush}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
                        <TextBlock Text="{Binding LiveriesCountText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding FavoritesCountText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DuplicatesCountText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PossibleDuplicatesCountText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconUser}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button x:Name="AddCardButton" Grid.Column="1" Classes="primary" Command="{Binding AddCardCommand}" />
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Classes="search" FontSize="13"
                     Margin="0,0,0,12" Text="{Binding SearchText, Mode=TwoWay}" />

            <ScrollViewer Grid.Row="2" IsVisible="{Binding !ShowEmptyState}">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource AuthorCardRowTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       IsVisible="{Binding ShowEmptyState}" Text="{Binding EmptyStateText}" />
        </Grid>
    </Grid>
</Window>
