<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveryGallery.Views.SettingsDialog"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconSettings}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="RequestClose">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" />

            <TextBlock x:Name="ThemeSectionLabel" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton x:Name="SystemThemeRadio" GroupName="ThemeGroup" Margin="0,0,24,0"
                             Click="ThemeOption_Click" />
                <RadioButton x:Name="LightThemeRadio" GroupName="ThemeGroup" Margin="0,0,24,0"
                             Click="ThemeOption_Click" />
                <RadioButton x:Name="DarkThemeRadio" GroupName="ThemeGroup"
                             Click="ThemeOption_Click" />
            </StackPanel>

            <TextBlock x:Name="LanguageSectionLabel" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox x:Name="LanguageCombo" Classes="modern" HorizontalAlignment="Stretch"
                      Margin="0,0,0,20" SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Tag="de" Content="Deutsch (DE)" />
                <ComboBoxItem Tag="en" Content="English (EN)" />
                <ComboBoxItem Tag="es" Content="Español (ES)" />
                <ComboBoxItem Tag="fr" Content="Français (FR)" />
                <ComboBoxItem Tag="it" Content="Italiano (IT)" />
                <ComboBoxItem Tag="ja" Content="日本語 (JA)" />
                <ComboBoxItem Tag="ko" Content="한국어 (KO)" />
                <ComboBoxItem Tag="pt" Content="Português (PT)" />
                <ComboBoxItem Tag="ru" Content="Русский (RU)" />
                <ComboBoxItem Tag="zh-Hans" Content="中文（简体） (ZH-CN)" />
                <ComboBoxItem Tag="zh-Hant" Content="中文（繁體） (ZH-TW)" />
            </ComboBox>

            <TextBlock x:Name="PathsSectionLabel" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <TextBlock x:Name="GamePathLabel" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <TextBox x:Name="GamePathBox" Grid.Column="0" Classes="search" FontSize="13"
                         Margin="0,0,8,0" IsEnabled="False" TextChanged="PathBox_TextChanged" />
                <Button x:Name="GameBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                        Content="..." IsEnabled="False" Click="GameBrowseButton_Click" />
            </Grid>

            <TextBlock x:Name="SavePathLabel" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <TextBox x:Name="SavePathBox" Grid.Column="0" Classes="search" FontSize="13"
                         Margin="0,0,8,0" TextChanged="PathBox_TextChanged" />
                <Button x:Name="SaveBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                        Content="..." Click="SaveBrowseButton_Click" />
            </Grid>

            <TextBlock x:Name="HintText" FontSize="11" Margin="0,10,0,0"
                       HorizontalAlignment="Stretch" MaxWidth="500"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

			<TextBlock x:Name="ScanningSectionLabel" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
			<CheckBox x:Name="AutoRefreshLiveriesCheckBox" Margin="0,0,0,10" Click="ScanOption_Click" />
			<CheckBox x:Name="RefreshOnButtonClickCheckBox" Click="ScanOption_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="ExitButton" Classes="secondary" MinWidth="120" Margin="0,0,10,0" Click="ExitButton_Click" />
                <Button x:Name="SaveButton" Classes="primary" MinWidth="120" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
