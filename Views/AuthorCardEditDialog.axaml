<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveryGallery.Views.AuthorCardEditDialog"
        Width="480" Height="820" 
		WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconUser}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="CancelButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <TextBlock x:Name="AliasesLabel" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="AliasesHint" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="AliasSearchBox" Classes="search" FontSize="12.5" Margin="0,0,0,8"
                             TextChanged="AliasSearchBox_TextChanged" />
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            MaxHeight="160" Padding="10,6">
                        <ScrollViewer>
                            <StackPanel x:Name="AliasesPanel" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="AliasesErrorText" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" IsVisible="False" />

                    <TextBlock x:Name="CustomNameLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="CustomNameBox" Classes="search" FontSize="13" />
                    <TextBlock x:Name="CustomNameErrorText" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" IsVisible="False" />

                    <TextBlock x:Name="DescriptionLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="DescriptionBox" Classes="search" FontSize="13"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70" />

                    <TextBlock x:Name="TwitterLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="TwitterBox" Classes="search" FontSize="13"
                             PlaceholderText="https://x.com/..." />
                    <TextBlock x:Name="TwitterErrorText" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" IsVisible="False" />

                    <TextBlock x:Name="YouTubeLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="YouTubeBox" Classes="search" FontSize="13"
                             PlaceholderText="https://youtube.com/@..." />
                    <TextBlock x:Name="YouTubeErrorText" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" IsVisible="False" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Classes="secondary" Width="100" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Classes="primary" Width="100" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
