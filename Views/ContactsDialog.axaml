<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveryGallery.Views.ContactsDialog"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="36" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0"
                Background="{DynamicResource ToolbarBrush}"
                PointerPressed="TitleBar_PointerPressed">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
					<Path Data="{StaticResource IconEnvelope}"
                          Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Margin="0,0,8,0" />
					<TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
				</StackPanel>

				<Button Grid.Column="1" Classes="titlebar close" Click="CloseButton_Click">
					<TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
				</Button>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

			<!-- GitHub -->
			<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
				<Path Data="{StaticResource IconGithub}" Width="18" Height="18" Stretch="Uniform"
                      Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
				<Button x:Name="GithubLinkButton" Classes="linkText" Click="GithubLink_Click" />
			</StackPanel>

			<!-- Twitter/X -->
			<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
				<Path Data="{StaticResource IconTwitter}" Width="18" Height="18" Stretch="Uniform"
                      Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
				<Button x:Name="TwitterLinkButton" Classes="linkText" Content="@bradice__livery" Click="TwitterLink_Click" />
			</StackPanel>

			<!-- Email -->
			<StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
				<Path Data="{StaticResource IconEnvelope}" Width="18" Height="18" Stretch="Uniform"
                      Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
				<TextBlock Text="tbradice@proton.me" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
			</StackPanel>

			<Button Grid.Row="4" x:Name="CloseDialogButton" Classes="secondary"
                    Width="110" HorizontalAlignment="Right" Margin="0,20,0,0" Click="CloseButton_Click" />
		</Grid>
	</Grid>
</Window>
