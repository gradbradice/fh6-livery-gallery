<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveryGallery.Views.AboutDialog"
        Width="540" Height="260" WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconInfo}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Path Data="{StaticResource IconFlag}" Width="30" Height="30" Stretch="Uniform"
                      Fill="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AppNameText" Text="FH6 Livery Gallery" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="VersionText" FontSize="12.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                <TextBlock x:Name="HeaderParserVersionText" FontSize="11" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>

            <Button Grid.Row="2" x:Name="CloseButton" Classes="primary"
                    Width="120" HorizontalAlignment="Right" Margin="0,20,0,0" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
