<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        xmlns:views="clr-namespace:LiveryGallery.Views"
        xmlns:c="clr-namespace:LiveryGallery.Controls"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        x:Class="LiveryGallery.Views.StatisticsWindow"
        x:DataType="vm:StatisticsViewModel"
        Width="1120" Height="800" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <!-- The page list on the left, as in the settings -->
        <Style Selector="ListBox.statsPages">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.statsPages ListBoxItem:selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- A number in a card; clickable ones lead to the gallery -->
        <Style Selector="Button.statTile">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.statTile.clickable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.statTile.clickable:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.statTile:not(.clickable):pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        </Style>
        <Style Selector="Button.statTile:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.statTile:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <!-- A row: a breakdown's bar, a health fact, a record -->
        <Style Selector="Button.statRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.statRow.clickable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.statRow.clickable:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.statRow:not(.clickable):pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.statRow:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.statRow:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <!-- Segmented choices: the scope, the range -->
        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.segment.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.segment.selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.segment.small">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.segments">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Border.segments.small">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style Selector="Button.columnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.columnHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <!-- A header whose text may wrap holds its own TextBlock: it looks like the others, on hover too -->
        <Style Selector="Button.columnHeader TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.columnHeader:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,0,0,8" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,0,6,8" />
        </Style>
        <Style Selector="c|ShareBar.warning">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="c|ShareBar.full">
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.slotsWarning">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.slotsFull">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="ListBox.authorTable ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ScrollViewer.page">
            <Setter Property="Margin" Value="0,0,-14,0" />
            <Setter Property="Padding" Value="0,0,4,0" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="vm:StatTileViewModel">
            <Button Classes="statTile" Classes.clickable="{Binding IsClickable}" Command="{Binding Command}"
                    ToolTip.Tip="{Binding Tooltip}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ShareRowTemplate" x:DataType="vm:ShareRowViewModel">
            <Button Classes="statRow" Classes.clickable="{Binding IsClickable}" Command="{Binding Command}"
                    ToolTip.Tip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Detail" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Percent" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <c:ShareBar Grid.Column="1" Fraction="{Binding Fraction}" Height="6" VerticalAlignment="Center" />
                    <!-- The numbers keep clear of the bar: a full bar ends where they begin -->
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12.5" FontWeight="SemiBold"
                               MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock Grid.Column="3" Text="{Binding DetailText}" FontSize="11.5" Classes="muted"
                               TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                               IsVisible="{Binding DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Grid.Column="4" Text="{Binding PercentText}" FontSize="11.5" Classes="muted"
                               MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                               IsVisible="{Binding PercentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FactTemplate" x:DataType="vm:FactViewModel">
            <Button Classes="statRow" Classes.clickable="{Binding IsClickable}" Command="{Binding Command}"
                    ToolTip.Tip="{Binding Tooltip}" Padding="6,5">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BreakdownTemplate" x:DataType="vm:BreakdownCardViewModel">
            <Border Classes="statCard">
                <StackPanel>
                    <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ShareRowTemplate}" Grid.IsSharedSizeScope="True" />
                    <TextBlock Text="{Binding MoreText}" IsVisible="{Binding HasMore}" FontSize="11.5" Classes="muted" Margin="6,4,0,0" />
                    <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" FontSize="12" Classes="muted" Margin="6,2,0,4" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LegendTemplate" x:DataType="vm:ChartLegendItem">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0">
                <c:SeriesKey Series="{Binding Series}" Width="14" Height="3" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontSize="11.5" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TwoColumns">
            <c:CardGrid Columns="2" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="OneRow">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid RowDefinitions="36,*">
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconStats}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static loc:Strings.StatsTitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar" Click="MaximizeButton_Click">
                    <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button Grid.Column="2" Classes="titlebar close" Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- Left: the pages, and the scope -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,20,12,16">
                    <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.StatsTitle}" FontSize="16" FontWeight="Bold" Margin="10,0,0,16" />
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                        <TextBlock Text="{x:Static loc:Strings.StatsScopeLabel}" FontSize="11.5" Classes="muted" Margin="10,0,0,0" />
                        <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="9" Padding="3">
                            <UniformGrid Rows="2">
                                <Button Classes="segment" Classes.selected="{Binding IsAllScope}" Command="{Binding ShowAllCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{x:Static loc:Strings.StatsScopeAll}" />
                                <Button Classes="segment" Classes.selected="{Binding IsShownScope}" Command="{Binding ShowShownCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{Binding ScopeShownText}" ToolTip.Tip="{x:Static loc:Strings.StatsScopeShownTooltip}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <ListBox x:Name="PageList" Classes="statsPages" SelectionMode="Single,AlwaysSelected"
                             SelectionChanged="PageList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:StatisticsPageItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{Binding Icon}" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Opacity="0" IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: the open page -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24,18,14,16">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,10,14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding ScopeNote}" FontSize="12" Classes="muted" MinHeight="16" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center" Content="{x:Static loc:Strings.StatsExport}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{x:Static loc:Strings.StatsExportLiveries}" Click="ExportLiveries_Click" />
                                <MenuItem Header="{x:Static loc:Strings.StatsExportAuthors}" Click="ExportAuthors_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Overview -->
                <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding IsOverviewPage}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <UniformGrid Columns="2">
                            <Border Classes="statCard">
                                <StackPanel>
                                    <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsSlotsTitle}" />
                                    <StackPanel IsVisible="{Binding HasLimit}" Margin="6,0,6,4" Spacing="6">
                                        <TextBlock Text="{Binding SlotsText}" FontSize="22" FontWeight="Bold" />
                                        <c:ShareBar Height="10" Fraction="{Binding SlotsFraction}"
                                                    Classes.warning="{Binding IsSlotsWarning}" Classes.full="{Binding IsSlotsFull}" />
                                        <TextBlock Text="{Binding SlotsDetail}" FontSize="12" TextWrapping="Wrap" Classes="muted"
                                                   Classes.slotsWarning="{Binding IsSlotsWarning}" Classes.slotsFull="{Binding IsSlotsFull}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Static loc:Strings.StatsSlotsNoLimit}" IsVisible="{Binding !HasLimit}" Classes="note" />
                                </StackPanel>
                            </Border>
                            <Border Classes="statCard">
                                <StackPanel>
                                    <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsPageHealth}" />
                                    <ItemsControl ItemsSource="{Binding HealthSummary}" ItemTemplate="{StaticResource FactTemplate}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Classes="statCard" IsVisible="{Binding HasAccounts}">
                            <StackPanel>
                                <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsAccountsTitle}" />
                                <Grid ColumnDefinitions="*,110,110,120" Margin="6,0,6,4">
                                    <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.StatsColumnLiveries}" FontSize="11.5" Classes="muted" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.StatsTileAuthors}" FontSize="11.5" Classes="muted" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.StatsColumnLast}" FontSize="11.5" Classes="muted" TextAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Accounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountSummary">
                                            <Grid ColumnDefinitions="*,110,110,120" Margin="6,3">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                           FontWeight="{Binding IsCurrent, Converter={x:Static views:StatisticsWindow.BoldWhenTrue}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Liveries, StringFormat={}{0:N0}}" FontSize="12.5" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Authors, StringFormat={}{0:N0}}" FontSize="12.5" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding Newest, StringFormat={}{0:d}, TargetNullValue=—}" FontSize="12" Classes="muted" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Health -->
                <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding IsHealthPage}">
                    <StackPanel>
                        <Border Classes="statCard" IsVisible="{Binding HasLimit}">
                            <StackPanel Margin="6,0,6,2" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Static loc:Strings.StatsSlotsTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Column="1" Text="{Binding SlotsText}" FontSize="22" FontWeight="Bold" />
                                </Grid>
                                <c:ShareBar Height="12" Fraction="{Binding SlotsFraction}"
                                            Classes.warning="{Binding IsSlotsWarning}" Classes.full="{Binding IsSlotsFull}" />
                                <TextBlock Text="{Binding SlotsDetail}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Classes.slotsWarning="{Binding IsSlotsWarning}" Classes.slotsFull="{Binding IsSlotsFull}" />
                                <TextBlock Text="{x:Static loc:Strings.StatsSlotsNote}" FontSize="11.5" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding HealthCards}" ItemsPanel="{StaticResource TwoColumns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HealthCardViewModel">
                                    <Border Classes="statCard">
                                        <StackPanel>
                                            <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                                            <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Collection -->
                <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding IsCollectionPage}">
                    <ItemsControl ItemsSource="{Binding Breakdowns}" ItemTemplate="{StaticResource BreakdownTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" VerticalAlignment="Top" />
                </ScrollViewer>

                <!-- Cars -->
                <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding IsCarsPage}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding CarTiles}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource OneRow}" />
                        <c:CardGrid Columns="2">
                            <!-- The coverage card: the breakdown card with a choice of order in its title row -->
                            <Border Classes="statCard">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                        <TextBlock Classes="cardTitle" Text="{Binding CoverageCard.Title}" Margin="6,0,10,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Classes="segments small" IsVisible="{Binding HasGameCars}">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Classes="segment small" Classes.selected="{Binding IsCoverageByLiveries}"
                                                        Command="{Binding SelectCoverageOrderCommand}" CommandParameter="{x:Static vm:CoverageOrder.Liveries}"
                                                        Content="{x:Static loc:Strings.StatsCoverageSortLiveries}"
                                                        ToolTip.Tip="{x:Static loc:Strings.StatsCoverageSortLiveriesTooltip}" />
                                                <Button Classes="segment small" Classes.selected="{Binding IsCoverageByCars}"
                                                        Command="{Binding SelectCoverageOrderCommand}" CommandParameter="{x:Static vm:CoverageOrder.Cars}"
                                                        Content="{x:Static loc:Strings.StatsCoverageSortCars}"
                                                        ToolTip.Tip="{x:Static loc:Strings.StatsCoverageSortCarsTooltip}" />
                                                <Button Classes="segment small" Classes.selected="{Binding IsCoverageByShare}"
                                                        Command="{Binding SelectCoverageOrderCommand}" CommandParameter="{x:Static vm:CoverageOrder.Share}"
                                                        Content="{x:Static loc:Strings.StatsCoverageSortShare}"
                                                        ToolTip.Tip="{x:Static loc:Strings.StatsCoverageSortShareTooltip}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CoverageCard.Rows}" ItemTemplate="{StaticResource ShareRowTemplate}" Grid.IsSharedSizeScope="True" />
                                    <TextBlock Text="{Binding CoverageCard.MoreText}" IsVisible="{Binding CoverageCard.HasMore}" FontSize="11.5" Classes="muted" Margin="6,4,0,0" />
                                    <TextBlock Text="{Binding CoverageCard.EmptyText}" IsVisible="{Binding CoverageCard.IsEmpty}" FontSize="12" Classes="muted" Margin="6,2,0,4" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <ContentControl Content="{Binding TopCarsCard}" ContentTemplate="{StaticResource BreakdownTemplate}" />
                        </c:CardGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Over time -->
                <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding IsTimePage}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RecentTiles}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource OneRow}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,10,10">
                            <TextBlock Text="{Binding JournalNote}" FontSize="11.5" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,16,0" />
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="9" Padding="3" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="segment" Classes.selected="{Binding IsRangeYear}" Command="{Binding SelectRangeCommand}"
                                            CommandParameter="{x:Static vm:HistoryRange.Year}" Content="{x:Static loc:Strings.StatsRangeYear}" />
                                    <Button Classes="segment" Classes.selected="{Binding IsRangeTwoYears}" Command="{Binding SelectRangeCommand}"
                                            CommandParameter="{x:Static vm:HistoryRange.TwoYears}" Content="{x:Static loc:Strings.StatsRangeTwoYears}" />
                                    <Button Classes="segment" Classes.selected="{Binding IsRangeAll}" Command="{Binding SelectRangeCommand}"
                                            CommandParameter="{x:Static vm:HistoryRange.All}" Content="{x:Static loc:Strings.StatsRangeAll}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="statCard chartCard">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsFlowTitle}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding FlowLegend}" ItemTemplate="{StaticResource LegendTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                                <c:MonthChart Height="210" Columns="{Binding FlowColumns}" UpSeries="{Binding FlowUpSeries}" DownSeries="{Binding FlowDownSeries}" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="{Binding SizeAndAuthorsColumns}">
                            <Border Classes="statCard chartCard" IsVisible="{Binding HasSize}">
                                <StackPanel>
                                    <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsSizeTitle}" />
                                    <c:MonthChart Height="140" IsLine="True" Columns="{Binding SizeColumns}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="statCard chartCard">
                                <StackPanel>
                                    <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsNewAuthorsTitle}" />
                                    <c:MonthChart Height="140" Columns="{Binding AuthorColumns}" UpSeries="{Binding SingleSeries}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Classes="statCard chartCard" IsVisible="{Binding HasCreated}">
                            <StackPanel>
                                <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsCreatedTitle}" />
                                <TextBlock Classes="note" Text="{Binding AgeText}" IsVisible="{Binding AgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <c:MonthChart Height="150" Columns="{Binding CreatedColumns}" UpSeries="{Binding SingleSeries}" />
                            </StackPanel>
                        </Border>

                        <!-- The calendar of the last year and, right of it, the days of the week, each in line with its row -->
                        <Border Classes="statCard chartCard">
                            <StackPanel>
                                <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsCalendarTitle}" />
                                <TextBlock Classes="note" Text="{Binding CalendarNote}" />
                                <c:CalendarHeatmap Days="{Binding CalendarDays}" TooltipFormat="{Binding CalendarTooltipFormat}"
                                                   WeekdayValues="{Binding WeekdayValues}" WeekdayTooltips="{Binding WeekdayTooltips}"
                                                   WeekdayTitle="{x:Static loc:Strings.StatsWeekdaysTitle}"
                                                   Margin="6,0,6,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Authors -->
                <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding IsAuthorsPage}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding AuthorTiles}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource OneRow}" />
                        <Grid ColumnDefinitions="360,*">
                            <Border Classes="statCard">
                                <StackPanel>
                                    <TextBlock Classes="cardTitle" Text="{Binding TopAuthorsTitle}" />
                                    <ItemsControl ItemsSource="{Binding TopAuthorRows}" ItemTemplate="{StaticResource ShareRowTemplate}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding AuthorCards}" ItemTemplate="{StaticResource BreakdownTemplate}"
                                          ItemsPanel="{StaticResource TwoColumns}" />
                        </Grid>

                        <Border Classes="statCard" Padding="8,10" Height="480">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBox Grid.Row="0" Classes="search" FontSize="12.5" Margin="4,0,4,8"
                                         Text="{Binding AuthorSearch, Mode=TwoWay}" PlaceholderText="{x:Static loc:Strings.StatsAuthorsSearch}" />
                                <!-- Lined up with the rows: the list keeps 14 px on the right for its scroll bar (drawn over the list),
                                     and a row's 6 px padding matches the header buttons' padding -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,96,66,92,96,96" Margin="0,0,14,2">
                                    <Button Grid.Column="0" Classes="columnHeader" HorizontalContentAlignment="Left"
                                            Command="{Binding SortAuthorsCommand}" CommandParameter="Name" Content="{x:Static loc:Strings.StatsColumnAuthor}" />
                                    <Button Grid.Column="1" Classes="columnHeader" HorizontalContentAlignment="Right"
                                            Command="{Binding SortAuthorsCommand}" CommandParameter="Liveries" Content="{x:Static loc:Strings.StatsColumnLiveries}" />
                                    <Button Grid.Column="2" Classes="columnHeader" HorizontalContentAlignment="Right"
                                            Command="{Binding SortAuthorsCommand}" CommandParameter="Cars" Content="{x:Static loc:Strings.StatsColumnCars}" />
                                    <Button Grid.Column="3" Classes="columnHeader" HorizontalContentAlignment="Right"
                                            Command="{Binding SortAuthorsCommand}" CommandParameter="Favorites" Content="{x:Static loc:Strings.StatsColumnFavorites}" />
                                    <!-- Two words that may wrap on two lines -->
                                    <Button Grid.Column="4" Classes="columnHeader" HorizontalContentAlignment="Right"
                                            Command="{Binding SortAuthorsCommand}" CommandParameter="FirstDownload"
                                            ToolTip.Tip="{x:Static loc:Strings.StatsColumnFirstDownloadTooltip}">
                                        <TextBlock Text="{x:Static loc:Strings.StatsColumnFirstDownload}" TextWrapping="Wrap" TextAlignment="Right" />
                                    </Button>
                                    <Button Grid.Column="5" Classes="columnHeader" HorizontalContentAlignment="Right"
                                            Command="{Binding SortAuthorsCommand}" CommandParameter="LastDownload"
                                            ToolTip.Tip="{x:Static loc:Strings.StatsColumnLastDownloadTooltip}">
                                        <TextBlock Text="{x:Static loc:Strings.StatsColumnLastDownload}" TextWrapping="Wrap" TextAlignment="Right" />
                                    </Button>
                                </Grid>
                                <Panel Grid.Row="2">
                                    <ListBox Classes="authorTable" ItemsSource="{Binding AuthorRows}" Background="Transparent" Padding="0,0,14,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AuthorTableRowViewModel">
                                                <Button Classes="statRow clickable" Command="{Binding Open}" Padding="6,5"
                                                        ToolTip.Tip="{x:Static loc:Strings.StatsAuthorRowTooltip}">
                                                    <Grid ColumnDefinitions="*,96,66,92,96,96">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding LiveriesText}" FontSize="12.5" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="{Binding CarsText}" FontSize="12.5" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding FavoritesText}" FontSize="12.5" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{Binding FirstDownloadText}" FontSize="12" Classes="muted" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="5" Text="{Binding LastDownloadText}" FontSize="12" Classes="muted" TextAlignment="Right" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{x:Static loc:Strings.StatsAuthorsNotFound}" IsVisible="{Binding NoAuthorsFound}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Classes="muted" />
                                </Panel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Liveries -->
                <ScrollViewer Grid.Row="1" Classes="page" IsVisible="{Binding IsLiveriesPage}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding LayerTiles}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource OneRow}" />
                        <c:CardGrid Columns="2">
                            <ContentControl Content="{Binding LayerHistogramCard}" ContentTemplate="{StaticResource BreakdownTemplate}" />
                            <Border Classes="statCard">
                                <StackPanel>
                                    <TextBlock Classes="cardTitle" Text="{x:Static loc:Strings.StatsRecordsTitle}" />
                                    <ItemsControl ItemsSource="{Binding Records}" ItemTemplate="{StaticResource FactTemplate}" />
                                </StackPanel>
                            </Border>
                            <ContentControl Content="{Binding MostComplexCard}" ContentTemplate="{StaticResource BreakdownTemplate}" />
                            <ContentControl Content="{Binding LayersByAuthorCard}" ContentTemplate="{StaticResource BreakdownTemplate}" />
                        </c:CardGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
