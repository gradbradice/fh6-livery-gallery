<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ForzaToolkit.UI;assembly=ForzaToolkit.UI.Avalonia"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        xmlns:views="using:LiveryGallery.Views"
        x:Class="LiveryGallery.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Width="820" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Window.Styles>
        <!-- The page list on the left: rounded rows, the open page in the accent colour -->
        <Style Selector="ListBox.settingsPages">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.settingsPages ListBoxItem:selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- A heading inside a page, and the small grey text under a setting -->
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconSettings}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="RequestClose">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <!-- Left: the pages -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,20,12,16">
                    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="10,0,0,16" />
                    <ListBox x:Name="PageList" Classes="settingsPages" SelectionMode="Single,AlwaysSelected"
                             SelectionChanged="PageList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:SettingsPageItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{Binding Icon}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <!-- The hidden bold copy takes the space of the selected title: a name that wraps
                                         in bold wraps always, and the rows do not move when the selection changes -->
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Opacity="0" IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: the open page, and the buttons under it -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" x:Name="PageTitleText" FontSize="16" FontWeight="Bold" Margin="28,20,28,16" />

                <ScrollViewer Grid.Row="1" x:Name="PageScroll"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Panel Margin="28,0,28,8">
                        <!-- Appearance: theme and language -->
                        <StackPanel x:Name="AppearancePage">
                            <TextBlock x:Name="ThemeSectionLabel" Classes="sectionLabel" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <RadioButton x:Name="SystemThemeRadio" GroupName="ThemeGroup" Margin="0,0,24,0"
                                             IsChecked="{Binding IsSystemTheme}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="{x:Static ui:AppThemeMode.System}" />
                                <RadioButton x:Name="LightThemeRadio" GroupName="ThemeGroup" Margin="0,0,24,0"
                                             IsChecked="{Binding IsLightTheme}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="{x:Static ui:AppThemeMode.Light}" />
                                <RadioButton x:Name="DarkThemeRadio" GroupName="ThemeGroup"
                                             IsChecked="{Binding IsDarkTheme}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="{x:Static ui:AppThemeMode.Dark}" />
                            </StackPanel>

                            <TextBlock x:Name="LanguageSectionLabel" Classes="sectionLabel" />
                            <ComboBox x:Name="LanguageCombo" Classes="modern" HorizontalAlignment="Stretch" Margin="0,0,0,24"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Car names, countries and car types: in a language of the game, taken from its files -->
                            <TextBlock x:Name="CarTextLanguageSectionLabel" Classes="sectionLabel" />
                            <ComboBox x:Name="CarTextLanguageCombo" Classes="modern" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding CarTextLanguageOptions}"
                                      SelectedItem="{Binding SelectedCarTextLanguageOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CarTextLanguageOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="CarTextLanguageHintText" Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Folders: the game and the save -->
                        <StackPanel x:Name="FoldersPage" IsVisible="False">
                            <TextBlock x:Name="GamePathLabel" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="GamePathBox" Grid.Column="0" Classes="search" FontSize="13"
                                         Margin="0,0,8,0" IsEnabled="False" Text="{Binding GamePath}" />
                                <Button x:Name="GameBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                                        Content="..." Click="GameBrowseButton_Click" />
                            </Grid>
                            <TextBlock x:Name="GameFolderStatusText" Classes="hint" Margin="0,6,0,20"
                                       Text="{Binding GameFolderStatusText}" />

                            <TextBlock x:Name="SavePathLabel" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="SavePathBox" Grid.Column="0" Classes="search" FontSize="13"
                                         Margin="0,0,8,0" Text="{Binding SavePath, Mode=TwoWay}" />
                                <Button x:Name="SaveBrowseButton" Grid.Column="1" Classes="secondary" Width="44"
                                        Content="..." Click="SaveBrowseButton_Click" />
                            </Grid>
                            <TextBlock x:Name="HintText" Classes="hint" Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- Gallery: scanning and duplicates -->
                        <StackPanel x:Name="GalleryPage" IsVisible="False">
                            <TextBlock x:Name="ScanningSectionLabel" Classes="sectionLabel" />
                            <CheckBox x:Name="AutoRefreshLiveriesCheckBox" Margin="0,0,0,10" IsChecked="{Binding AutoRefreshLiveries}" />
                            <CheckBox x:Name="RefreshOnButtonClickCheckBox" Margin="0,0,0,10" IsChecked="{Binding RefreshOnButtonClick}" />
                            <CheckBox x:Name="SearchByFolderNameCheckBox" Margin="0,0,0,10" IsChecked="{Binding SearchByFolderName}" />
                            <CheckBox x:Name="ShowChangesSinceLastLaunchCheckBox" Margin="0,0,0,10"
                                      IsChecked="{Binding ShowChangesSinceLastLaunch}" />
                            <CheckBox x:Name="WarnFewFreeSlotsCheckBox" Margin="0,0,0,24" IsChecked="{Binding WarnFewFreeSlots}" />

                            <TextBlock x:Name="DuplicatesSectionLabel" Classes="sectionLabel" />
                            <TextBlock x:Name="PossibleDuplicateThresholdLabel" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider x:Name="PossibleDuplicateThresholdSlider" Grid.Column="0"
                                        Minimum="{Binding MinPossibleDuplicateThreshold}" Maximum="{Binding MaxPossibleDuplicateThreshold}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                        Value="{Binding PossibleDuplicateThreshold, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding PossibleDuplicateThresholdText}" MinWidth="44"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="PossibleDuplicateThresholdHint" Classes="hint" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Backups: what the gallery backs up on its own, and how many it keeps -->
                        <StackPanel x:Name="BackupsPage" IsVisible="False">
                            <TextBlock x:Name="AutoBackupSectionLabel" Classes="sectionLabel" />
                            <CheckBox x:Name="AutoBackupBeforeArchiveCheckBox" Margin="0,0,0,10" IsChecked="{Binding AutoBackupBeforeArchive}" />
                            <CheckBox x:Name="AutoBackupOnChangeCheckBox" Margin="0,0,0,10" IsChecked="{Binding AutoBackupOnChange}" />
                            <CheckBox x:Name="AutoBackupPeriodicCheckBox" Margin="0,0,0,4" IsChecked="{Binding AutoBackupPeriodic}" />
                            <Grid ColumnDefinitions="*,Auto" Margin="28,0,0,20" IsEnabled="{Binding AutoBackupPeriodic}">
                                <Slider Grid.Column="0" Minimum="{Binding MinAutoBackupPeriodDays}" Maximum="{Binding MaxAutoBackupPeriodDays}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding AutoBackupPeriodDays, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding AutoBackupPeriodText}" MinWidth="64"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="AutoBackupKeepLabel" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0" Minimum="{Binding MinAutoBackupKeep}" Maximum="{Binding MaxAutoBackupKeep}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding AutoBackupKeep, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding AutoBackupKeepText}" MinWidth="64"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="AutoBackupHint" Classes="hint" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Find in game: the rows of the in-game list and the key interval -->
                        <StackPanel x:Name="FindInGamePage" IsVisible="False">
                            <TextBlock x:Name="NavigationRowsLabel" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <ComboBox x:Name="NavigationRowsCombo" Classes="modern" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding RowsModeOptions}"
                                      SelectedItem="{Binding SelectedRowsModeOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RowsModeOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="NavigationRowsStatusText" Classes="hint" Margin="0,4,0,12"
                                       Text="{Binding RowsStatusText}"
                                       IsVisible="{Binding RowsStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock x:Name="NavigationKeyIntervalLabel" FontSize="13" Margin="0,12,0,4" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider x:Name="NavigationKeyIntervalSlider" Grid.Column="0"
                                        Minimum="{Binding MinKeyInterval}" Maximum="{Binding MaxKeyInterval}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding KeyInterval, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding KeyIntervalText}" MinWidth="56"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="NavigationKeyIntervalHint" Classes="hint" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Server: the connection and what it sends -->
                        <StackPanel x:Name="ServerPage" IsVisible="False">
                            <CheckBox x:Name="ServerConnectionCheckBox" IsChecked="{Binding ServerConnectionEnabled}"
                                      IsCheckedChanged="ServerConnectionCheckBox_IsCheckedChanged" />
                            <TextBlock x:Name="ServerConnectionDescription" Classes="hint" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Data: stored accounts and the diagnostics export -->
                        <StackPanel x:Name="DataPage" IsVisible="False">
                            <StackPanel x:Name="AccountDataSection" IsVisible="False" Margin="0,0,0,24">
                                <TextBlock x:Name="AccountDataSectionLabel" Classes="sectionLabel" />
                                <TextBlock x:Name="AccountDataHint" Classes="hint" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding StoredAccounts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StoredAccountRowViewModel">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       IsVisible="{Binding !IsGone}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       IsVisible="{Binding IsGone}"
                                                                       Foreground="{DynamicResource WarningBrush}" />
                                                            <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="secondary" Padding="10,4" VerticalAlignment="Center"
                                                            Content="{Binding ForgetButtonText}"
                                                            IsVisible="{Binding CanForget}" Click="ForgetAccountButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="DiagnosticsSection">
                                <TextBlock x:Name="DiagnosticsSectionLabel" Classes="sectionLabel" />
                                <TextBlock x:Name="DiagnosticsHint" Classes="hint" Margin="0,0,0,10" />
                                <Button x:Name="ExportDiagnosticsButton" Classes="secondary" HorizontalAlignment="Left" MinWidth="180"
                                        Click="ExportDiagnosticsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,16,28,24">
                    <Button x:Name="ExitButton" Classes="secondary" MinWidth="120" Margin="0,0,10,0" Click="ExitButton_Click" />
                    <Button x:Name="SaveButton" Classes="primary" MinWidth="120" IsEnabled="{Binding IsDirty}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
