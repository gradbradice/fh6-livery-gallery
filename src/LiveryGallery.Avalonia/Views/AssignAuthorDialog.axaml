<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        x:Class="LiveryGallery.Views.AssignAuthorDialog"
        x:DataType="vm:AssignAuthorViewModel"
        Width="480" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <DataTemplate x:Key="AuthorChoiceTemplate" x:DataType="vm:AuthorChoiceRow">
            <StackPanel Margin="2,4" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconUser}" Width="11" Height="11" Stretch="Uniform"
                          VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="380" />
                </StackPanel>
                <!-- A hint says why in the accent colour; another author lists its other nicknames -->
                <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap" Margin="17,0,0,0"
                           IsVisible="{Binding HasDetail}"
                           Classes.hint="{Binding IsHint}"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock.hint">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconUser}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Command="{Binding CancelCommand}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="{Binding LiveryText}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding NoteText}" FontSize="12" TextWrapping="Wrap" />
                    <!-- Several selected: those with an account's id are not changed -->
                    <TextBlock Text="{Binding SkippedText}" IsVisible="{Binding HasSkipped}" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Classes="search" FontSize="12.5"
                             Text="{Binding SearchText, Mode=TwoWay}" />
                    <Button x:Name="NewCardButton" Grid.Column="1" Classes="secondary" Margin="8,0,0,0"
                            Command="{Binding NewCardCommand}" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="4">
                    <Panel>
                        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource AuthorChoiceTemplate}"
                                 Background="Transparent" />
                        <TextBlock x:Name="NoResultsText" IsVisible="{Binding ShowNoResults}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Panel>
                </Border>
            </Grid>

            <CheckBox x:Name="ConfirmCheckBox" Grid.Row="3" Margin="0,14,0,0"
                      IsChecked="{Binding IsConfirmed, Mode=TwoWay}" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Classes="secondary" MinWidth="100" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="SaveButton" Classes="primary" MinWidth="100" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
