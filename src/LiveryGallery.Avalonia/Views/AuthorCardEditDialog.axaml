<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        x:Class="LiveryGallery.Views.AuthorCardEditDialog"
        x:DataType="vm:AuthorCardEditViewModel"
        Width="480" Height="820" 
		WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <DataTemplate x:Key="AccountCheckboxTemplate" x:DataType="vm:AccountCheckboxViewModel">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsVisible="{Binding IsVisible}" Margin="0,3">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconUser}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Command="{Binding CancelCommand}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="AutoGeneratedNotice" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding ShowAutoGeneratedNotice}" />
            </StackPanel>

            <!-- The bar sits in the window's right margin and hides until used, so it never covers the fields -->
            <ScrollViewer Grid.Row="1" Margin="0,0,-20,0" AllowAutoHide="True"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock x:Name="AccountsLabel" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="AccountsHint" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="AccountSearchBox" Classes="search" FontSize="12.5" Margin="0,0,0,8"
                             Text="{Binding AccountSearchText, Mode=TwoWay}" />
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            MaxHeight="220" Padding="10,6">
                        <ScrollViewer AllowAutoHide="True" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AvailableAccounts}" Margin="0,0,14,0"
                                          ItemTemplate="{StaticResource AccountCheckboxTemplate}" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding HasAccountsError}" Text="{Binding AccountsErrorText}" />

                    <TextBlock x:Name="CustomNameLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="CustomNameBox" Classes="search" FontSize="13"
                             Text="{Binding CustomName, Mode=TwoWay}" />
                    <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding HasCustomNameError}" Text="{Binding CustomNameErrorText}" />

                    <TextBlock x:Name="DescriptionLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="DescriptionBox" Classes="search" FontSize="13"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                             Text="{Binding Description, Mode=TwoWay}" />

                    <TextBlock x:Name="TwitterLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="TwitterBox" Classes="search" FontSize="13"
                             PlaceholderText="https://x.com/..." Text="{Binding TwitterUrl, Mode=TwoWay}" />
                    <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding HasTwitterError}" Text="{Binding TwitterErrorText}" />

                    <TextBlock x:Name="YouTubeLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="YouTubeBox" Classes="search" FontSize="13"
                             PlaceholderText="https://youtube.com/@..." Text="{Binding YouTubeUrl, Mode=TwoWay}" />
                    <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding HasYouTubeError}" Text="{Binding YouTubeErrorText}" />

                    <TextBlock x:Name="TwitchLabel" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox x:Name="TwitchBox" Classes="search" FontSize="13"
                             PlaceholderText="https://twitch.tv/..." Text="{Binding TwitchUrl, Mode=TwoWay}" />
                    <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding HasTwitchError}" Text="{Binding TwitchErrorText}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Classes="secondary" Width="100" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="SaveButton" Classes="primary" Width="100" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
