<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LiveryGallery.Views"
        xmlns:loc="clr-namespace:LiveryGallery.Localisation"
        xmlns:vm="clr-namespace:LiveryGallery.ViewModels"
        x:Class="LiveryGallery.Views.ChangesSinceLastLaunchDialog"
        x:DataType="vm:ChangesSinceLastLaunchViewModel"
        Width="620" Height="680" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <DataTemplate x:Key="ChangedLiveryRowTemplate" x:DataType="vm:ChangedLiveryRowViewModel">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="144" Height="81" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource ThumbnailPlaceholderBrush}" Margin="0,0,12,0"
                            Opacity="{Binding ThumbnailOpacity}"
                            views:ThumbnailRows.Track="True">
                        <Grid>
                            <Path Data="{StaticResource IconCarSide}" Width="28" Height="28" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{DynamicResource ThumbnailPlaceholderTextBrush}"
                                  IsVisible="{Binding ShowPlaceholder}" />
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding LiveryName}" FontSize="13.5" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LiveryName}" />
                            <TextBlock Grid.Column="1" Text="{Binding LiveryIdText}" FontSize="11" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Author}" FontSize="11.5" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CarText}" FontSize="11.5" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,5,0,0">
                            <Border IsVisible="{Binding IsAuction}" Background="{DynamicResource AuctionBrush}"
                                    CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_AuctionBadgeLabel}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <Border IsVisible="{Binding IsMine}" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_MyLiveryBadgeLabel}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding DateText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding SummaryText}" FontSize="13.5" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <TabControl Grid.Row="1" SelectedIndex="{Binding InitialTabIndex, Mode=OneTime}">
                <TabItem Header="{Binding AddedTabHeader}">
                    <Grid>
                        <ScrollViewer Classes="gutter" IsVisible="{Binding !ShowNoAddedHint}" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding AddedRows}"
                                          ItemTemplate="{StaticResource ChangedLiveryRowTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   IsVisible="{Binding ShowNoAddedHint}"
                                   Text="{x:Static loc:Strings.ChangesNoneAddedHint}" />
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding RemovedTabHeader}">
                    <Grid>
                        <ScrollViewer Classes="gutter" IsVisible="{Binding !ShowNoRemovedHint}" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding RemovedRows}"
                                          ItemTemplate="{StaticResource ChangedLiveryRowTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   IsVisible="{Binding ShowNoRemovedHint}"
                                   Text="{x:Static loc:Strings.ChangesNoneRemovedHint}" />
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <CheckBox x:Name="DontShowAgainCheckBox" Grid.Column="0" VerticalAlignment="Center"
                          Margin="0,0,12,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button x:Name="CloseDialogButton" Grid.Column="1" Classes="primary" MinWidth="110"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
