<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:LiveryGallery.Views"
        x:Class="LiveryGallery.Views.TagEditDialog"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Height="36"
                PointerPressed="TitleBar_PointerPressed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconBookmark}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="titlebar close" Click="CancelButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" />
            <TextBlock x:Name="HintText" Grid.Row="1" FontSize="11.5" Margin="0,4,0,12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Spacing="8">
                <!-- Several liveries: every tag of the gallery, ticked on all of them, on some (a square) or on none -->
                <ScrollViewer x:Name="ManyTagsScroll" IsVisible="False" MaxHeight="220"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ManyTagsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="v:TagCheckRow">
                                <CheckBox Content="{Binding Tag}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsThreeState="{Binding IsThreeState}" ToolTip.Tip="{Binding Tooltip}"
                                          FontSize="13" Margin="0,0,16,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="NewTagsLabel" IsVisible="False" FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox x:Name="TagsBox" Classes="search" FontSize="13" KeyDown="TagsBox_KeyDown" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Classes="secondary" Width="100" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Classes="primary" Width="100" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
